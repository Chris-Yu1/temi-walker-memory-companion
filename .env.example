# Copy this file to .env.local and add your server-side API key.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.4-mini
QUESTION_MODEL=gpt-4.1
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=fable

# Optional: set this to an HTTPS tunnel or public reverse-proxy URL for phone uploads.
# Example: PUBLIC_UPLOAD_BASE_URL=https://your-name.trycloudflare.com
PUBLIC_UPLOAD_BASE_URL=

# Walker connection settings. Keep real credentials in .env.local only.
WALKER_SSH_HOST=
WALKER_SSH_USER=
WALKER_SSH_PASSWORD=
